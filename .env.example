# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.

HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- Gemini (Arena AI Image Generation - Optional) ---
# Used for generating world overview panoramas, biome artwork, and boss illustrations.
# If omitted or invalid, Arena automatically falls back to its built-in procedural SVG engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# --- Arena security and integrations ---
# Generate a long random value for AUTH_SECRET; never reuse a public token.
AUTH_SECRET=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
SESSION_JOIN_CODE_TTL_HOURS=24
# Disabled by default. Any future demo-only verification flow must be visibly labeled.
ARENA_DEMO_VERIFICATION=false
# Opt-in only: accepts explicitly simulated live-world activity rows.
ARENA_DEV_SIMULATOR=0
